{
  "name": "@nulib/clover-mcp",
  "version": "0.1.2",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nulib-labs/clover-mcp.git"
  },
  "description": "",
  "workspaces": [
    "./examples/local-server"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build --config src/vite.config.ts",
    "build:ui": "vite build --config viewer/vite.config.ts",
    "build:watch": "vite build --config viewer/vite.config.ts --watch",
    "lint": "eslint .",
    "prebuild": "npm run build:ui",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "npm version $npm_new_version --workspace=examples/local-server --no-git-tag-version && git add examples/local-server/package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@samvera/clover-iiif": "^3.4",
    "@types/node": "^25.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.0"
  }
}
